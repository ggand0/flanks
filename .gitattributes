# Unit models carry an embedded texture atlas, several MB each, and are
# revised often.
assets/units/*.glb filter=lfs diff=lfs merge=lfs -text
# The far soldiers' sprite sheet (tools/sprite_sheet.py), about 25 MB.
assets/units/sprites.png filter=lfs diff=lfs merge=lfs -text
assets/terrain/*.ktx2 filter=lfs diff=lfs merge=lfs -text
assets/terrain/*.png filter=lfs diff=lfs merge=lfs -text
assets/vegetation/*.glb filter=lfs diff=lfs merge=lfs -text
# The walled town's models and their shared atlases.
assets/town/*.glb filter=lfs diff=lfs merge=lfs -text
assets/town/*.png filter=lfs diff=lfs merge=lfs -text
assets/town/*.ktx2 filter=lfs diff=lfs merge=lfs -text
